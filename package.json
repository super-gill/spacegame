{
  "name": "spacegame",
  "version": "0.20.0",
  "private": true,
  "description": "Shared-world 2D free-roam space sim in the spirit of Flatspace. Node server, browser client, TypeScript, Canvas 2D.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@spacegame/client",
    "build": "npm run build --workspace=@spacegame/sim && npm run ships && npm run build --workspace=@spacegame/client",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "preview": "npm run preview --workspace=@spacegame/client",
    "audit": "vite-node scripts/audit.ts",
    "start": "npm run start --workspace=@spacegame/server",
    "stop": "node scripts/server.mjs stop",
    "restart": "node scripts/server.mjs restart",
    "update": "node scripts/server.mjs update",
    "status": "node scripts/server.mjs status",
    "ships": "node scripts/ships.mjs",
    "geometry": "node scripts/geometry.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "typescript": "^5.6.3"
  }
}
